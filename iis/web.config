<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Allow large file uploads up to 30MB -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
      </requestFiltering>
    </security>

    <!-- Reverse Proxy all requests to Next.js running on port 3000 -->
    <rewrite>
      <rules>
        <rule name="AEMS_NextJS_Reverse_Proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Pass Next.js errors directly through without IIS custom error override -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
