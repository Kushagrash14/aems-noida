# Copy to .env.production.local on the EC2 server and fill in real values.
#   cp aws/env.example .env.production.local

# --- App ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://aems.example.com
# Long random string: openssl rand -hex 32
SESSION_SECRET=
# Set to true once HTTPS (certbot) is enabled on Nginx
SESSION_COOKIE_SECURE=false

# --- Amazon RDS MySQL 8 ---
DB_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=aems_app
DB_PASSWORD=
DB_NAME=aems
# true = TLS using the Amazon RDS CA bundle (recommended)
DB_SSL=true
DB_POOL_SIZE=10

# --- Amazon S3 (attachments) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=aems-attachments
# Leave empty when the EC2 instance has an IAM role with S3 access (recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Office 365 SMTP (OTP email) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
OTP_FROM_EMAIL=